# Local dev (npm run dev:api): copy to apps/api/.env.
# Docker (docker compose up): copy to .env at the repo root — PORT and
# PORTAL_DB_CLIENT/HOST/PORT are overridden by docker-compose.yml itself in
# that case, but PORTAL_DB_NAME/USER/PASSWORD, PORTAL_MASTER_KEY, JWT_SECRET,
# and SYNC_CRON still come from here.
#
# Generate PORTAL_MASTER_KEY and JWT_SECRET with: openssl rand -hex 32
# (each must be exactly 64 hex characters / 32 bytes).

# Portal-owned database (hp_* tables). Chosen once during setup wizard step 6.
# Ignored by docker-compose (it hardcodes these to talk to the portal-db
# service), used directly for local dev.
PORTAL_DB_CLIENT=pg
PORTAL_DB_HOST=localhost
PORTAL_DB_PORT=5432
PORTAL_DB_NAME=homework_portal
PORTAL_DB_USER=postgres
PORTAL_DB_PASSWORD=change-me

PORTAL_MASTER_KEY=
JWT_SECRET=

PORT=4000
# Cron schedule for the nightly mirror sync (default 2am)
SYNC_CRON=0 2 * * *

# docker-compose only: host-side port mappings — change if these collide
# with something else already running on the host.
PORTAL_DB_HOST_PORT=5432
API_HOST_PORT=4000
WEB_HOST_PORT=8080
