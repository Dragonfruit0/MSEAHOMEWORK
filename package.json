{
  "name": "homework-portal",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:packages": "npm run build --workspace=packages/shared --workspace=packages/db-adapters --workspace=packages/mapping",
    "build": "npm run build:packages && npm run build --workspace=apps/api --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate --workspace=apps/api",
    "migrate:rollback": "npm run migrate:rollback --workspace=apps/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.16.5"
  }
}
